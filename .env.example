# Karachi Bites — Environment Variables Configuration

# -------------------------------------------------------------
# APPLICATION DEPLOYMENT
# -------------------------------------------------------------
# APP_URL: Public URL of the deployed application (e.g. https://karachi-bites.vercel.app)
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Application environment ('production' or 'development')
NODE_ENV="development"

# -------------------------------------------------------------
# SUPABASE POSTGRESQL PRODUCTION DATABASE (REQUIRED IN PRODUCTION)
# -------------------------------------------------------------
# SUPABASE_URL: Your project API URL found in Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-only secret key with elevated database privileges
# Found in Supabase Dashboard > Project Settings > API > service_role (secret)
# NEVER expose this key to browser bundles, git, or client code.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# -------------------------------------------------------------
# KARACHI BITES ADMINISTRATOR CONFIGURATION
# -------------------------------------------------------------
# ADMIN_USERNAME: Authorized Administrator username (default: 'Karachi Bites')
ADMIN_USERNAME="Karachi Bites"

# ADMIN_EMAIL: Authorized Administrator owner email address
ADMIN_EMAIL="karachibites@gmail.com"

# ADMIN_PASSWORD: Strong private administrator password (hashed with salt on startup)
# In production on Vercel, set this securely via Vercel Project Settings > Environment Variables
ADMIN_PASSWORD="YourStrongPrivatePasswordHere!"

# -------------------------------------------------------------
# LOCAL DEVELOPMENT STORAGE FALLBACK
# -------------------------------------------------------------
# DATA_DIR: Local JSON flat file storage directory used when Supabase is not configured in local dev
DATA_DIR="./data"

# -------------------------------------------------------------
# SESSION SECURITY
# -------------------------------------------------------------
# SESSION_SECRET: Secret key used for session security and signing
SESSION_SECRET="kb_random_secret_string_change_in_production"
