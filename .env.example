# Karachi Bites — Environment Variables Configuration

# -------------------------------------------------------------
# APPLICATION DEPLOYMENT
# -------------------------------------------------------------
# APP_URL: Public URL of the deployed application (e.g. https://karachi-bites.vercel.app)
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Application environment ('production' or 'development')
NODE_ENV="development"

# -------------------------------------------------------------
# KARACHI BITES ADMINISTRATOR CONFIGURATION
# -------------------------------------------------------------
# ADMIN_USERNAME: Authorized Administrator username (default: 'Karachi Bytes')
ADMIN_USERNAME="Karachi Bytes"

# ADMIN_EMAIL: Authorized Administrator owner email address
ADMIN_EMAIL="mshamikhsheikh2@gmail.com"

# ADMIN_PASSWORD: Strong administrator password (hashed with salt on startup)
# In production on Vercel, set this securely via Vercel Project Settings > Environment Variables
ADMIN_PASSWORD="KarachiBites@2026!"

# -------------------------------------------------------------
# DUAL-MODE STORAGE & PERSISTENCE
# -------------------------------------------------------------
# MODE 1: Local Filesystem Storage (Active by default)
# DATA_DIR: Path to storage directory for local JSON database (users.json and orders.json)
# Correct default: './data' locally, or '/tmp/karachi_bites_data' in Vercel preview environments
DATA_DIR="./data"

# MODE 2: Production Cloud Persistence on Vercel (Recommended for production)
# When Vercel KV is attached to your Vercel project, Vercel automatically injects these two variables.
# When present, Karachi Bites seamlessly persists orders and admin accounts to Vercel KV across all deployments.
# KV_REST_API_URL="https://your-kv-store.upstash.io"
# KV_REST_API_TOKEN="your_kv_rest_token_here"

# -------------------------------------------------------------
# SESSION SECURITY
# -------------------------------------------------------------
# SESSION_SECRET: Secret key used for session security and signing
SESSION_SECRET="kb_random_secret_string_change_in_production"
